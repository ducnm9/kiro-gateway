{
    "$schema": "https://opencode.ai/config.json",
    "model": "kiro/auto-kiro",
    "providers": {
        "kiro": {
            "name": "Kiro Gateway",
            "package": "@opencode-ai/ai/providers/openai-compatible",
            "env": [
                "KIRO_GATEWAY_API_KEY"
            ],
            "settings": {
                "baseURL": "http://localhost:8000/v1",
                "apiKey": "{env:KIRO_GATEWAY_API_KEY}"
            },
            "models": {
                "auto-kiro": {
                    "modelID": "auto",
                    "name": "Auto (Kiro)",
                    "capabilities": {
                        "tools": true,
                        "input": [
                            "text",
                            "image"
                        ],
                        "output": [
                            "text"
                        ]
                    },
                    "limit": {
                        "context": 200000,
                        "output": 32000
                    },
                    "variants": [
                        {
                            "id": "low",
